{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder-gamekit/schemas/game-concept.schema.json",
  "title": "Sanbuilder Game Concept",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "directionId",
    "name",
    "audiencePromise",
    "playerVerbs",
    "coreMechanic",
    "sessionLoop",
    "progression",
    "inputModel",
    "differenceAxes",
    "testableHypothesis",
    "scope",
    "evidence",
    "risks",
    "productionCost",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "game-concept" },
    "runId": { "type": "string", "minLength": 1 },
    "directionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "audiencePromise": { "type": "string", "minLength": 1 },
    "playerVerbs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "coreMechanic": { "type": "string", "minLength": 1 },
    "sessionLoop": { "type": "string", "minLength": 1 },
    "progression": { "type": "string", "minLength": 1 },
    "inputModel": { "type": "string", "minLength": 1 },
    "differenceAxes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["mechanic", "loop", "progression", "input", "composition", "risk-reward", "difficulty"] }
    },
    "testableHypothesis": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "productionCost": { "enum": ["low", "medium", "high", "unknown"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["brief", "research", "production", "reference", "playtest", "hypothesis"] },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
