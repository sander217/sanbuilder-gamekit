{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder-gamekit/schemas/h5-game-qa.schema.json",
  "title": "Sanbuilder H5 Game QA Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "proposalDigest",
    "implementationDigest",
    "targetDevices",
    "checks",
    "measurements",
    "blockingFailures",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "h5-game-qa" },
    "runId": { "type": "string", "minLength": 1 },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "implementationDigest": { "$ref": "#/$defs/digest" },
    "targetDevices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "measurements": {
      "type": "object",
      "required": ["minimumFps", "maximumInputLatencyMs", "transferBytes"],
      "properties": {
        "minimumFps": { "type": "number", "minimum": 0 },
        "maximumInputLatencyMs": { "type": "number", "minimum": 0 },
        "peakMemoryBytes": { "type": "integer", "minimum": 0 },
        "transferBytes": { "type": "integer", "minimum": 0 },
        "longSessionMinutes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blockingFailures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["passed", "failed", "incomplete"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": { "properties": { "blockingFailures": { "type": "array", "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "check": {
      "type": "object",
      "required": ["id", "category", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "enum": ["loop", "input", "lifecycle", "performance", "accessibility", "integrity", "assets", "privacy"] },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "evidence": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
