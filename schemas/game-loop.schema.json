{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder-gamekit/schemas/game-loop.schema.json",
  "title": "Sanbuilder Game Loop",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "conceptDigest",
    "playerVerbs",
    "states",
    "rules",
    "scoring",
    "difficulty",
    "tutorial",
    "failureAndRetry",
    "lifecycle",
    "feedback",
    "accessibility",
    "persistence",
    "testHooks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "game-loop" },
    "runId": { "type": "string", "minLength": 1 },
    "conceptDigest": { "$ref": "#/$defs/digest" },
    "playerVerbs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "states": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/state" } },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scoring": { "type": "string", "minLength": 1 },
    "difficulty": { "type": "string", "minLength": 1 },
    "tutorial": { "type": "string", "minLength": 1 },
    "failureAndRetry": { "type": "string", "minLength": 1 },
    "pause": { "type": "string", "minLength": 1 },
    "lifecycle": { "type": "string", "minLength": 1 },
    "audio": { "type": "string", "minLength": 1 },
    "feedback": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "persistence": { "type": "string", "minLength": 1 },
    "telemetry": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testHooks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "state": {
      "type": "object",
      "required": ["id", "entry", "exit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "entry": { "type": "string", "minLength": 1 },
        "exit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
