{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder-gamekit/schemas/playable-prototype.schema.json",
  "title": "Sanbuilder Playable Prototype",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "conceptDigest",
    "gameLoopDigest",
    "sourceDigest",
    "hypotheses",
    "controls",
    "targetViewports",
    "assetProvenance",
    "knownShortcuts",
    "performanceBudget",
    "playtestPlan",
    "productionTruth",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "playable-prototype" },
    "runId": { "type": "string", "minLength": 1 },
    "conceptDigest": { "$ref": "#/$defs/digest" },
    "gameLoopDigest": { "$ref": "#/$defs/digest" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "hypotheses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "controls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targetViewports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" } },
    "assetProvenance": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "knownShortcuts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "performanceBudget": {
      "type": "object",
      "required": ["minimumFps", "maximumInputLatencyMs", "maximumTransferBytes"],
      "properties": {
        "minimumFps": { "type": "number", "exclusiveMinimum": 0 },
        "maximumInputLatencyMs": { "type": "number", "exclusiveMinimum": 0 },
        "maximumTransferBytes": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "playtestPlan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "productionTruth": { "const": false },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "required": ["path", "source", "licenseStatus"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "licenseStatus": { "enum": ["owned", "licensed", "generated-reviewed", "placeholder", "unknown"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
